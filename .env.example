# ASR provider. Use "funasr" for local/self-hosted FunASR, "aliyun" for Alibaba Cloud file transcription,
# or "none" to keep audio uploads in "待转写/可补充文本".
ASR_PROVIDER=funasr

# FunASR HTTP service. This POC expects a multipart POST endpoint that accepts the audio file
# and returns text in common shapes such as {"text":"..."}, {"result":"..."}, {"data":{"text":"..."}}.
FUNASR_ENDPOINT=http://127.0.0.1:10095/asr
FUNASR_AUDIO_FIELD=audio
FUNASR_RESPONSE_PATH=auto

# Alibaba Cloud RAM AccessKey. Required only when ASR_PROVIDER=aliyun. Do not commit real keys.
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=

# 阿里云智能语音交互控制台中的 AppKey
ALIYUN_NLS_APP_KEY=

# 录音文件识别区域，一般按你的阿里云服务开通区域填写
ALIYUN_REGION=cn-shanghai

# 可选：覆盖录音文件识别 endpoint
# ALIYUN_FILETRANS_ENDPOINT=https://filetrans.cn-shanghai.aliyuncs.com

# 必填：阿里云 ASR 必须能访问音频文件。localhost 不可用。
# POC 可使用公网反向代理、测试对象存储 URL，生产建议使用 OSS。
# 例如：https://your-public-domain.example.com
ALIYUN_ASR_PUBLIC_BASE_URL=

# 开启说话人分离。人数为 0 时由算法判断；门店固定双人接待可设置为 2。
ALIYUN_ASR_DIARIZATION_ENABLED=true
ALIYUN_ASR_SPEAKER_COUNT=0

# OSS upload for Alibaba ASR. Recommended for this POC because Alibaba cannot access localhost uploads.
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_REGION=cn-beijing
# 例如：https://your-bucket.oss-cn-beijing.aliyuncs.com
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_PREFIX=uploads

# Fact layer LLM. Used for Qwen/DashScope OpenAI-compatible fact extraction.
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen3.7-max

# 可选：店长企业微信群机器人地址。三级客户意向触发后由服务端推送；不配置时页面显示待配置。
# 在企业微信群中添加群机器人后，复制 webhook 地址填写到这里。请勿提交真实地址。
MANAGER_WECHAT_WEBHOOK=
MANAGER_WECHAT_USER_IDS=
MANAGER_WECHAT_MOBILES=
